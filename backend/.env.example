# Port 5000 is used by macOS AirPlay Receiver, so 5001 is the default here.
PORT=5001

# Environment mode. Set to "production" to enable secure (HTTPS-only) cookies.
NODE_ENV=development

# Origin of the frontend app, used for the CORS allow-list (must be exact,
# no wildcard, since credentials/cookies are enabled).
FRONTEND_URL=http://localhost:5173

# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value or reuse it across environments.
JWT_SECRET=replace-with-a-long-random-secret
